{
  "name": "bullmq-monorepo",
  "private": true,
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "build:shared": "pnpm --filter ./packages/shared build",
    "dev:shared": "pnpm --filter ./packages/shared dev",
    "dev:api": "pnpm --filter ./apps/api start:dev",
    "dev:front": "pnpm --filter ./apps/frontend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r --parallel typecheck",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec postgres psql -U user -d bullmq",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "prettier": "^3.4.2"
  }
}
