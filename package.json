{
  "name": "bullmq-monorepo",
  "private": true,
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "build:shared": "pnpm --filter ./packages/shared build",
    "dev:shared": "pnpm --filter ./packages/shared dev",
    "dev:api": "pnpm --filter ./apps/api start:dev",
    "dev:front": "pnpm --filter ./apps/frontend dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:shared && pnpm -r --parallel typecheck",
    "test": "pnpm build:shared && pnpm -r --parallel test",
    "lint": "pnpm build:shared && pnpm -r --parallel lint",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec postgres psql -U user -d bullmq",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^24.13.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.4.2"
  }
}
