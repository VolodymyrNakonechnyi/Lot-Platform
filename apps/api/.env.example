DATABASE_URL=postgres://user:password@localhost:5434/bullmq
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=3000
# Mailpit catches everything locally (MP_SMTP_AUTH_ACCEPT_ANY takes any user/pass).
# Real delivery, e.g. Gmail: smtps://user%40gmail.com:<app-password>@smtp.gmail.com:465
SMTP_URL=smtp://dev:dev@localhost:1025
# Gmail and other relays reject a From they have not verified.
MAIL_FROM=Accounts <accounts@example.com>
# Dev only: send every verification mail to this address instead of the user's.
MAIL_REDIRECT_TO=
WEB_ORIGIN=http://localhost:5173
# Signs mobile/CLI access tokens (ES256). Generate a P-256 PKCS#8 key:
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# Keep the PEM in double quotes: Node's --env-file reads quoted values across lines.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----"
# Key id published in the JWT header; any stable string, e.g. the RFC 7638 JWK thumbprint.
JWT_KID=
SEED_PASSWORD=mockadmin123
# MFA Encryption key
TOTP_ENCRYPTION_KEY=